    \shade[left color=PidCvLapis,right color=PidCvLapis!88!PidCvTurquoise]
      (0,0) rectangle (\linewidth,7mm);
    \path[pattern=pidworkflowtitlerosette,pattern color=white,opacity=0.045]
      (0,0) rectangle (0.2\linewidth,7mm);
    \path[pattern=pidworkflowtitlerosette,pattern color=white,opacity=0.080]
      (0.2\linewidth,0) rectangle (0.4\linewidth,7mm);
    \path[pattern=pidworkflowtitlerosette,pattern color=white,opacity=0.130]
      (0.4\linewidth,0) rectangle (0.6\linewidth,7mm);
    \path[pattern=pidworkflowtitlerosette,pattern color=white,opacity=0.080]
      (0.6\linewidth,0) rectangle (0.8\linewidth,7mm);
    \path[pattern=pidworkflowtitlerosette,pattern color=white,opacity=0.045]
      (0.8\linewidth,0) rectangle (\linewidth,7mm);
    \draw[PidCvSaffron,opacity=0.72,line width=0.65pt] (0,0) -- (\linewidth,0);
    \node[anchor=west,inner sep=0,text=white,font=\sffamily\small\bfseries]
