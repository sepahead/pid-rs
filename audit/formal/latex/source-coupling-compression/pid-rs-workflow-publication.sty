\renewcommand{\PidReportTitle}[2]{%
  {\sffamily\bfseries\fontsize{25}{29}\selectfont\color{PidCvLapis}#1\par}%
  \vspace{0.45em}%
  {\sffamily\fontsize{12.5}{15}\selectfont\color{PidCvTurquoise}#2\par}%
}

\newcommand{\PidWorkflowSectionRail}{%
  \par\noindent
  \textcolor{PidCvSaffron}{\rule{3.8em}{1.15pt}}%
  \textcolor{PidCvMineral}{\rule{\dimexpr\linewidth-3.8em\relax}{0.45pt}}%
}

\newcommand{\PidWorkflowConfigureSections}{%
  \titleformat{\section}
    {\Large\sffamily\bfseries\color{PidCvLapis}}
    {\thesection}{0.70em}{}
    [\vspace{0.17em}\PidWorkflowSectionRail]
  \titlespacing*{\section}{0pt}{1.55em}{0.70em}
  \titleformat{\subsection}
    {\large\sffamily\bfseries\color{PidCvTurquoise}}
    {\thesubsection}{0.65em}{}
  \titlespacing*{\subsection}{0pt}{1.25em}{0.48em}
  \titleformat{\subsubsection}
    {\normalsize\sffamily\bfseries\color{PidCvLapis}}
    {\thesubsubsection}{0.58em}{}
  \titlespacing*{\subsubsection}{0pt}{1.05em}{0.38em}
  \titleformat{\paragraph}[block]
    {\normalsize\sffamily\bfseries\color{PidCvTurquoise}}
    {}{0pt}{}
  \titlespacing*{\paragraph}{0pt}{0.82em}{0.28em}
}
% Reserve space before invoking the numbered heading command. Hyperref fixes a destination when
% the heading begins; allowing the heading itself to force a page break can therefore leave the
% bookmark and table-of-contents target on the preceding page.
\newcommand{\PidWorkflowSection}[1]{%
  \par\Needspace{14\baselineskip}%
  \section{#1}%
}
\newcommand{\PidWorkflowSubsection}[1]{%
  \par\Needspace{7\baselineskip}%
  \subsection{#1}%
}
\newcommand{\PidWorkflowSubsubsection}[1]{%
  \par\Needspace{6\baselineskip}%
  \subsubsection{#1}%
}
\newcommand{\PidWorkflowParagraph}[1]{%
  \par\Needspace{8\baselineskip}%
  \paragraph{#1}%
}
\makeatother

% TeX Live 2024 accepts graphicx's alt key but does not emit tagged-PDF /Alt content. Argument #2
% is therefore retained as source-level descriptive prose only. The report is deliberately
% untagged, and neither this macro nor the visual receipt claims PDF accessibility conformance.
\newcommand{\PidWorkflowFigure}[3]{%
  \begin{figure}[htbp]
    \centering
    \includegraphics[width=\linewidth,alt={#2}]{#1.pdf}%
    \caption{#3}%
    \label{fig:#1}%
  \end{figure}%
}

