% A low-contrast, vector-only paper grain. It is decorative and carries no meaning.
\pgfdeclarepatternformonly{pidworkflowpapergrain}
  {\pgfpoint{0pt}{0pt}}
  {\pgfpoint{18pt}{18pt}}
  {\pgfpoint{18pt}{18pt}}
  {%
    \pgfsetlinewidth{0.12pt}%
    \pgfpathmoveto{\pgfpoint{1.5pt}{4.0pt}}%
    \pgfpathlineto{\pgfpoint{6.5pt}{4.3pt}}%
    \pgfpathmoveto{\pgfpoint{11.0pt}{12.0pt}}%
    \pgfpathlineto{\pgfpoint{16.0pt}{11.7pt}}%
    \pgfpathmoveto{\pgfpoint{4.0pt}{16.0pt}}%
    \pgfpathlineto{\pgfpoint{8.0pt}{15.8pt}}%
    \pgfusepath{stroke}%
  }

% Compact title-band rosette. The five clipped fields below vary only decorative opacity; the
% visible title remains real text and the motif carries no status or quantitative meaning.
\pgfdeclarepatternformonly{pidworkflowtitlerosette}
  {\pgfpoint{0pt}{0pt}}
  {\pgfpoint{12pt}{12pt}}
  {\pgfpoint{12pt}{12pt}}
  {%
    \pgfsetlinewidth{0.28pt}%
    \pgfsetroundcap%
    \pgfsetroundjoin%
    \pgfpathmoveto{\pgfpoint{6pt}{0.7pt}}%
    \pgfpathlineto{\pgfpoint{7.5pt}{4.5pt}}%
    \pgfpathlineto{\pgfpoint{11.3pt}{6pt}}%
    \pgfpathlineto{\pgfpoint{7.5pt}{7.5pt}}%
    \pgfpathlineto{\pgfpoint{6pt}{11.3pt}}%
    \pgfpathlineto{\pgfpoint{4.5pt}{7.5pt}}%
    \pgfpathlineto{\pgfpoint{0.7pt}{6pt}}%
    \pgfpathlineto{\pgfpoint{4.5pt}{4.5pt}}%
    \pgfpathclose%
    \pgfpathcircle{\pgfpoint{6pt}{6pt}}{0.42pt}%
    \pgfusepath{stroke}%
  }

\newcommand{\PidWorkflowRosette}{%
  \begin{scope}[opacity=0.17]
    \foreach \angle in {0,45,...,315}{%
      \draw[PidCvSaffron,line width=0.28pt]
        (0,0) -- (\angle:7.2mm);
      \draw[PidCvTurquoise,line width=0.24pt]
        (\angle:2.4mm) -- ({\angle+22.5}:5.2mm);
    }
    \draw[PidCvLapis,line width=0.28pt] (0,0) circle (4.8mm);
    \draw[PidCvSaffron,line width=0.24pt,rotate=22.5] (0,0) rectangle (6.5mm,6.5mm);
  \end{scope}%
}

\newcommand{\PidWorkflowPageGround}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[PidCvIvory]
      (current page.south west) rectangle (current page.north east);
    \path[pattern=pidworkflowpapergrain,pattern color=PidCvMineral,opacity=0.24]
      (current page.south west) rectangle (current page.north east);
    % Restrained structural weave: registration bars at the sheet edges.
    \fill[PidCvLapis,opacity=0.08]
      (current page.north west) rectangle
      ([yshift=-2.1mm]current page.north east);
    \fill[PidCvTurquoise,opacity=0.07]
      ([yshift=2.1mm]current page.south west) rectangle
      (current page.south east);
    \foreach \x in {0,12,...,204}{%
      \draw[PidCvMineral,opacity=0.38,line width=0.25pt]
        ([xshift=\x mm,yshift=-0.5mm]current page.north west) -- ++(6mm,-1.2mm);
    }
    \begin{scope}[shift={([xshift=-7.5mm,yshift=-7.5mm]current page.north east)}]
      \PidWorkflowRosette
    \end{scope}
    \begin{scope}[shift={([xshift=7.5mm,yshift=7.5mm]current page.south west)},rotate=180]
      \PidWorkflowRosette
    \end{scope}
  \end{tikzpicture}%
}
\AddToShipoutPictureBG{\PidWorkflowPageGround}

