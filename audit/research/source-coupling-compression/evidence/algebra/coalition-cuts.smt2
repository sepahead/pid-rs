; Full original carrier, seven coalition cuts, four sign choices each.
; a_u is a signed real atom change, v_u >= both a_u and -a_u.
; B_A sums actual original incidence below the single branch A.
(set-logic QF_LRA)
(declare-const a_k1_2_4 Real)
(declare-const a_k1_2 Real)
(declare-const a_k1_4 Real)
(declare-const a_k2_4 Real)
(declare-const a_k1_6 Real)
(declare-const a_k2_5 Real)
(declare-const a_k3_4 Real)
(declare-const a_k1 Real)
(declare-const a_k2 Real)
(declare-const a_k4 Real)
(declare-const a_k3_5_6 Real)
(declare-const a_k3_5 Real)
(declare-const a_k3_6 Real)
(declare-const a_k5_6 Real)
(declare-const a_k3 Real)
(declare-const a_k5 Real)
(declare-const a_k6 Real)
(declare-const a_k7 Real)
(declare-const v_k1_2_4 Real)
(declare-const v_k1_2 Real)
(declare-const v_k1_4 Real)
(declare-const v_k2_4 Real)
(declare-const v_k1_6 Real)
(declare-const v_k2_5 Real)
(declare-const v_k3_4 Real)
(declare-const v_k1 Real)
(declare-const v_k2 Real)
(declare-const v_k4 Real)
(declare-const v_k3_5_6 Real)
(declare-const v_k3_5 Real)
(declare-const v_k3_6 Real)
(declare-const v_k5_6 Real)
(declare-const v_k3 Real)
(declare-const v_k5 Real)
(declare-const v_k6 Real)
(declare-const v_k7 Real)
(define-fun L () Real (+ a_k1_2_4 a_k1_2 a_k1_4 a_k2_4 a_k1_6 a_k2_5 a_k3_4 a_k1 a_k2 a_k4 a_k3_5_6 a_k3_5 a_k3_6 a_k5_6 a_k3 a_k5 a_k6 a_k7))
(define-fun V () Real (+ v_k1_2_4 v_k1_2 v_k1_4 v_k2_4 v_k1_6 v_k2_5 v_k3_4 v_k1 v_k2 v_k4 v_k3_5_6 v_k3_5 v_k3_6 v_k5_6 v_k3 v_k5 v_k6 v_k7))
; A=1,2,3,4,5,6,7 are branch masks, not node-array indices.
(define-fun B1 () Real (+ a_k1_2_4 a_k1_2 a_k1_4 a_k1_6 a_k1))
(define-fun B2 () Real (+ a_k1_2_4 a_k1_2 a_k2_4 a_k2_5 a_k2))
(define-fun B3 () Real (+ a_k1_2_4 a_k1_2 a_k1_4 a_k2_4 a_k1_6 a_k2_5 a_k3_4 a_k1 a_k2 a_k3_5_6 a_k3_5 a_k3_6 a_k3))
(define-fun B4 () Real (+ a_k1_2_4 a_k1_4 a_k2_4 a_k3_4 a_k4))
(define-fun B5 () Real (+ a_k1_2_4 a_k1_2 a_k1_4 a_k2_4 a_k1_6 a_k2_5 a_k3_4 a_k1 a_k4 a_k3_5_6 a_k3_5 a_k5_6 a_k5))
(define-fun B6 () Real (+ a_k1_2_4 a_k1_2 a_k1_4 a_k2_4 a_k1_6 a_k2_5 a_k3_4 a_k2 a_k4 a_k3_5_6 a_k3_6 a_k5_6 a_k6))
(define-fun B7 () Real (+ a_k1_2_4 a_k1_2 a_k1_4 a_k2_4 a_k1_6 a_k2_5 a_k3_4 a_k1 a_k2 a_k4 a_k3_5_6 a_k3_5 a_k3_6 a_k5_6 a_k3 a_k5 a_k6 a_k7))
(assert (and
  (>= v_k1_2_4 a_k1_2_4) (>= v_k1_2 a_k1_2)
  (>= v_k1_4 a_k1_4) (>= v_k2_4 a_k2_4)
  (>= v_k1_6 a_k1_6) (>= v_k2_5 a_k2_5)
  (>= v_k3_4 a_k3_4) (>= v_k1 a_k1)
  (>= v_k2 a_k2) (>= v_k4 a_k4)
  (>= v_k3_5_6 a_k3_5_6) (>= v_k3_5 a_k3_5)
  (>= v_k3_6 a_k3_6) (>= v_k5_6 a_k5_6)
  (>= v_k3 a_k3) (>= v_k5 a_k5)
  (>= v_k6 a_k6) (>= v_k7 a_k7)))
(assert (and
  (>= v_k1_2_4 (- a_k1_2_4)) (>= v_k1_2 (- a_k1_2))
  (>= v_k1_4 (- a_k1_4)) (>= v_k2_4 (- a_k2_4))
  (>= v_k1_6 (- a_k1_6)) (>= v_k2_5 (- a_k2_5))
  (>= v_k3_4 (- a_k3_4)) (>= v_k1 (- a_k1))
  (>= v_k2 (- a_k2)) (>= v_k4 (- a_k4))
  (>= v_k3_5_6 (- a_k3_5_6)) (>= v_k3_5 (- a_k3_5))
  (>= v_k3_6 (- a_k3_6)) (>= v_k5_6 (- a_k5_6))
  (>= v_k3 (- a_k3)) (>= v_k5 (- a_k5))
  (>= v_k6 (- a_k6)) (>= v_k7 (- a_k7))))
(echo "C01:A1:s+:t+")
(push 1)
(assert (not (>= V (+ B1 (- L B1)))))
(check-sat)
(pop 1)
(echo "C02:A1:s+:t-")
(push 1)
(assert (not (>= V (+ B1 (- (- L B1))))))
(check-sat)
(pop 1)
(echo "C03:A1:s-:t+")
(push 1)
(assert (not (>= V (+ (- B1) (- L B1)))))
(check-sat)
(pop 1)
(echo "C04:A1:s-:t-")
(push 1)
(assert (not (>= V (+ (- B1) (- (- L B1))))))
(check-sat)
(pop 1)
(echo "C05:A2:s+:t+")
(push 1)
(assert (not (>= V (+ B2 (- L B2)))))
(check-sat)
(pop 1)
(echo "C06:A2:s+:t-")
(push 1)
(assert (not (>= V (+ B2 (- (- L B2))))))
(check-sat)
(pop 1)
(echo "C07:A2:s-:t+")
(push 1)
(assert (not (>= V (+ (- B2) (- L B2)))))
(check-sat)
(pop 1)
(echo "C08:A2:s-:t-")
(push 1)
(assert (not (>= V (+ (- B2) (- (- L B2))))))
(check-sat)
(pop 1)
(echo "C09:A3:s+:t+")
(push 1)
(assert (not (>= V (+ B3 (- L B3)))))
(check-sat)
(pop 1)
(echo "C10:A3:s+:t-")
(push 1)
(assert (not (>= V (+ B3 (- (- L B3))))))
(check-sat)
(pop 1)
(echo "C11:A3:s-:t+")
(push 1)
(assert (not (>= V (+ (- B3) (- L B3)))))
(check-sat)
(pop 1)
(echo "C12:A3:s-:t-")
(push 1)
(assert (not (>= V (+ (- B3) (- (- L B3))))))
(check-sat)
(pop 1)
(echo "C13:A4:s+:t+")
(push 1)
(assert (not (>= V (+ B4 (- L B4)))))
(check-sat)
(pop 1)
(echo "C14:A4:s+:t-")
(push 1)
(assert (not (>= V (+ B4 (- (- L B4))))))
(check-sat)
(pop 1)
(echo "C15:A4:s-:t+")
(push 1)
(assert (not (>= V (+ (- B4) (- L B4)))))
(check-sat)
(pop 1)
(echo "C16:A4:s-:t-")
(push 1)
(assert (not (>= V (+ (- B4) (- (- L B4))))))
(check-sat)
(pop 1)
(echo "C17:A5:s+:t+")
(push 1)
(assert (not (>= V (+ B5 (- L B5)))))
(check-sat)
(pop 1)
(echo "C18:A5:s+:t-")
(push 1)
(assert (not (>= V (+ B5 (- (- L B5))))))
(check-sat)
(pop 1)
(echo "C19:A5:s-:t+")
(push 1)
(assert (not (>= V (+ (- B5) (- L B5)))))
(check-sat)
(pop 1)
(echo "C20:A5:s-:t-")
(push 1)
(assert (not (>= V (+ (- B5) (- (- L B5))))))
(check-sat)
(pop 1)
(echo "C21:A6:s+:t+")
(push 1)
(assert (not (>= V (+ B6 (- L B6)))))
(check-sat)
(pop 1)
(echo "C22:A6:s+:t-")
(push 1)
(assert (not (>= V (+ B6 (- (- L B6))))))
(check-sat)
(pop 1)
(echo "C23:A6:s-:t+")
(push 1)
(assert (not (>= V (+ (- B6) (- L B6)))))
(check-sat)
(pop 1)
(echo "C24:A6:s-:t-")
(push 1)
(assert (not (>= V (+ (- B6) (- (- L B6))))))
(check-sat)
(pop 1)
(echo "C25:A7:s+:t+")
(push 1)
(assert (not (>= V (+ B7 (- L B7)))))
(check-sat)
(pop 1)
(echo "C26:A7:s+:t-")
(push 1)
(assert (not (>= V (+ B7 (- (- L B7))))))
(check-sat)
(pop 1)
(echo "C27:A7:s-:t+")
(push 1)
(assert (not (>= V (+ (- B7) (- L B7)))))
(check-sat)
(pop 1)
(echo "C28:A7:s-:t-")
(push 1)
(assert (not (>= V (+ (- B7) (- (- L B7))))))
(check-sat)
(pop 1)
