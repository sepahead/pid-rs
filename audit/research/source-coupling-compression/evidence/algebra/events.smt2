; Original three-source anchored event congruence.
; Masks use source bits 1,2,4. A node is OR across AND branches.
; No probabilities, observed support, or lossy-map premise is encoded.
(set-logic QF_UF)
(declare-const x1 Bool)
(declare-const x2 Bool)
(declare-const x3 Bool)
(declare-const y1 Bool)
(declare-const y2 Bool)
(declare-const y3 Bool)
(assert (= x1 y1))
(assert (= x2 y2))
(assert (= x3 y3))
(define-fun e_k1_2_4 () Bool (or x1 x2 x3))
(define-fun f_k1_2_4 () Bool (or y1 y2 y3))
(define-fun e_k1_2 () Bool (or x1 x2))
(define-fun f_k1_2 () Bool (or y1 y2))
(define-fun e_k1_4 () Bool (or x1 x3))
(define-fun f_k1_4 () Bool (or y1 y3))
(define-fun e_k2_4 () Bool (or x2 x3))
(define-fun f_k2_4 () Bool (or y2 y3))
(define-fun e_k1_6 () Bool (or x1 (and x2 x3)))
(define-fun f_k1_6 () Bool (or y1 (and y2 y3)))
(define-fun e_k2_5 () Bool (or x2 (and x1 x3)))
(define-fun f_k2_5 () Bool (or y2 (and y1 y3)))
(define-fun e_k3_4 () Bool (or (and x1 x2) x3))
(define-fun f_k3_4 () Bool (or (and y1 y2) y3))
(define-fun e_k1 () Bool x1)
(define-fun f_k1 () Bool y1)
(define-fun e_k2 () Bool x2)
(define-fun f_k2 () Bool y2)
(define-fun e_k4 () Bool x3)
(define-fun f_k4 () Bool y3)
(define-fun e_k3_5_6 () Bool (or (and x1 x2) (and x1 x3) (and x2 x3)))
(define-fun f_k3_5_6 () Bool (or (and y1 y2) (and y1 y3) (and y2 y3)))
(define-fun e_k3_5 () Bool (or (and x1 x2) (and x1 x3)))
(define-fun f_k3_5 () Bool (or (and y1 y2) (and y1 y3)))
(define-fun e_k3_6 () Bool (or (and x1 x2) (and x2 x3)))
(define-fun f_k3_6 () Bool (or (and y1 y2) (and y2 y3)))
(define-fun e_k5_6 () Bool (or (and x1 x3) (and x2 x3)))
(define-fun f_k5_6 () Bool (or (and y1 y3) (and y2 y3)))
(define-fun e_k3 () Bool (and x1 x2))
(define-fun f_k3 () Bool (and y1 y2))
(define-fun e_k5 () Bool (and x1 x3))
(define-fun f_k5 () Bool (and y1 y3))
(define-fun e_k6 () Bool (and x2 x3))
(define-fun f_k6 () Bool (and y2 y3))
(define-fun e_k7 () Bool (and x1 x2 x3))
(define-fun f_k7 () Bool (and y1 y2 y3))
(echo "E01:k1_2_4")
(push 1)
(assert (not (= e_k1_2_4 f_k1_2_4)))
(check-sat)
(pop 1)
(echo "E02:k1_2")
(push 1)
(assert (not (= e_k1_2 f_k1_2)))
(check-sat)
(pop 1)
(echo "E03:k1_4")
(push 1)
(assert (not (= e_k1_4 f_k1_4)))
(check-sat)
(pop 1)
(echo "E04:k2_4")
(push 1)
(assert (not (= e_k2_4 f_k2_4)))
(check-sat)
(pop 1)
(echo "E05:k1_6")
(push 1)
(assert (not (= e_k1_6 f_k1_6)))
(check-sat)
(pop 1)
(echo "E06:k2_5")
(push 1)
(assert (not (= e_k2_5 f_k2_5)))
(check-sat)
(pop 1)
(echo "E07:k3_4")
(push 1)
(assert (not (= e_k3_4 f_k3_4)))
(check-sat)
(pop 1)
(echo "E08:k1")
(push 1)
(assert (not (= e_k1 f_k1)))
(check-sat)
(pop 1)
(echo "E09:k2")
(push 1)
(assert (not (= e_k2 f_k2)))
(check-sat)
(pop 1)
(echo "E10:k4")
(push 1)
(assert (not (= e_k4 f_k4)))
(check-sat)
(pop 1)
(echo "E11:k3_5_6")
(push 1)
(assert (not (= e_k3_5_6 f_k3_5_6)))
(check-sat)
(pop 1)
(echo "E12:k3_5")
(push 1)
(assert (not (= e_k3_5 f_k3_5)))
(check-sat)
(pop 1)
(echo "E13:k3_6")
(push 1)
(assert (not (= e_k3_6 f_k3_6)))
(check-sat)
(pop 1)
(echo "E14:k5_6")
(push 1)
(assert (not (= e_k5_6 f_k5_6)))
(check-sat)
(pop 1)
(echo "E15:k3")
(push 1)
(assert (not (= e_k3 f_k3)))
(check-sat)
(pop 1)
(echo "E16:k5")
(push 1)
(assert (not (= e_k5 f_k5)))
(check-sat)
(pop 1)
(echo "E17:k6")
(push 1)
(assert (not (= e_k6 f_k6)))
(check-sat)
(pop 1)
(echo "E18:k7")
(push 1)
(assert (not (= e_k7 f_k7)))
(check-sat)
(pop 1)
