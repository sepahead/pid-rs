def lookupRight (ready : Bool) (i : Fin 83) (x : Nat) : Nat :=
  if ready then entries i.val + x else entries i.val + x + 1

def Guarded (i : Fin 83) : Prop :=
  ∀ (ready : Bool) (x : Nat), ready = true → 0 < i.val →
    calcLeft i x = lookupRight ready i x

