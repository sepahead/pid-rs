(set-logic ALL)
(set-option :produce-models true)
(declare-const forgotten Int)
(declare-const leftCell (_ BitVec 4))
(declare-const twin (_ BitVec 4))
(declare-const rightCell (_ BitVec 4))
(define-fun artificialEqual ((l (_ BitVec 4)) (r (_ BitVec 4))) Bool (= ((_ extract 1 1) l) ((_ extract 1 1) r)))
(echo "ARTIFICIAL Pair")
(assert (artificialEqual leftCell rightCell))
(assert (not (artificialEqual leftCell rightCell)))
(check-sat)
(exit)
