{
  "$defs": {
    "nonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "repositoryPath": {
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
      "type": "string"
    },
    "sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "task": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/repositoryPath"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "local_evidence_status": {
          "enum": [
            "ARTIFACT_ADDED_UNREVIEWED",
            "IMPLEMENTED_AT_0_9_SOURCE_OFFER_MILESTONE",
            "NOT_ASSESSED_FOR_TASK_CLOSURE"
          ]
        },
        "implementation_state": {
          "enum": [
            "BOUNDED_EVIDENCE_ADDED_POST_TAG",
            "IMPLEMENTED_AT_0_9_MILESTONE",
            "NOT_ESTABLISHED_BY_THIS_ARTIFACT"
          ]
        },
        "reason_code": {
          "enum": [
            "BOUNDED_FORMAL_EVIDENCE_ADDED",
            "CROSS_REPOSITORY_QUALIFICATION_NOT_CLAIMED",
            "EXTERNAL_CUSTODY_OR_REPRODUCTION_REQUIRED",
            "FULL_ACCEPTANCE_RECORD_NOT_PRESENT",
            "LOCAL_REGISTRY_OR_INVENTORY_ADDED",
            "MILESTONE_IMPLEMENTED_FULL_QUALIFICATION_OPEN"
          ]
        },
        "scope_note": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "task_id": {
          "pattern": "^T(0[0-9]{2}|1[0-5][0-9])$",
          "type": "string"
        },
        "v0_9_source_offer_disposition": {
          "const": "NOT_USED_TO_QUALIFY_TASK"
        },
        "v1_0_disposition": {
          "enum": [
            "BLOCKED_EXTERNAL",
            "CLAIM_REMOVED",
            "OPEN_LOCAL"
          ]
        }
      },
      "required": [
        "evidence",
        "implementation_state",
        "local_evidence_status",
        "reason_code",
        "scope_note",
        "task_id",
        "v0_9_source_offer_disposition",
        "v1_0_disposition"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/sepahead/pid-rs/blob/main/audit/schemas/task-dispositions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generated_by": {
      "const": "scripts/check-review-evidence.py"
    },
    "release_boundary": {
      "additionalProperties": false,
      "properties": {
        "final_decision_claimed": {
          "const": false
        },
        "independent_completion_claimed": {
          "const": false
        },
        "qualification_note": {
          "const": "Bounded implementation evidence does not satisfy the full 1.0 task completion rule."
        },
        "tag": {
          "const": "v0.9.0"
        },
        "tag_object_sha": {
          "$ref": "#/$defs/sha1"
        },
        "tagged_commit_sha": {
          "$ref": "#/$defs/sha1"
        },
        "v0_9_source_offer_status": {
          "const": "PUBLISHED_FOR_REVIEW"
        },
        "v1_0_qualification_status": {
          "const": "NOT_QUALIFIED"
        }
      },
      "required": [
        "final_decision_claimed",
        "independent_completion_claimed",
        "qualification_note",
        "tag",
        "tag_object_sha",
        "tagged_commit_sha",
        "v0_9_source_offer_status",
        "v1_0_qualification_status"
      ],
      "type": "object"
    },
    "schema": {
      "const": "pid-rs/task-dispositions"
    },
    "schema_revision": {
      "const": 2
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "handoff_ledger_declared_commit": {
          "$ref": "#/$defs/sha1"
        },
        "handoff_ledger_lineage_status": {
          "const": "NOT_ANCESTOR_OF_TAGGED_COMMIT"
        },
        "handoff_ledger_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "intake_commit_lineage_status": {
          "const": "ANCESTOR_OF_TAGGED_COMMIT"
        },
        "intake_repository_commit": {
          "$ref": "#/$defs/sha1"
        },
        "task_id_set": {
          "const": "T000..T158 inclusive"
        }
      },
      "required": [
        "handoff_ledger_declared_commit",
        "handoff_ledger_lineage_status",
        "handoff_ledger_sha256",
        "intake_commit_lineage_status",
        "intake_repository_commit",
        "task_id_set"
      ],
      "type": "object"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "blocked_external": {
          "type": "integer"
        },
        "claim_removed": {
          "const": 0
        },
        "open_local": {
          "type": "integer"
        },
        "qualified_complete": {
          "const": 0
        },
        "task_count": {
          "const": 159
        }
      },
      "required": [
        "blocked_external",
        "claim_removed",
        "open_local",
        "qualified_complete",
        "task_count"
      ],
      "type": "object"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/task"
      },
      "maxItems": 159,
      "minItems": 159,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "generated_by",
    "release_boundary",
    "schema",
    "schema_revision",
    "source",
    "summary",
    "tasks"
  ],
  "title": "pid-rs 1.0 handoff task dispositions",
  "type": "object"
}
