{
  "$defs": {
    "construction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "record_eligibility": {
          "enum": [
            "firewall_only_no_errata_records",
            "open_source_obligations",
            "source_erratum_candidates"
          ]
        },
        "regime": {
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "transfer_rule": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "record_eligibility",
        "regime",
        "source_ids",
        "transfer_rule"
      ],
      "type": "object"
    },
    "implementation_disposition": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "implemented_with_bounded_regression",
            "no_direct_implementation_effect",
            "not_implemented_fail_closed"
          ]
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "status",
        "summary"
      ],
      "type": "object"
    },
    "locator": {
      "additionalProperties": false,
      "properties": {
        "named_object": {
          "minLength": 1,
          "type": "string"
        },
        "physical_pdf_pages": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "textual_anchor": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "named_object",
        "physical_pdf_pages",
        "textual_anchor"
      ],
      "type": "object"
    },
    "proposed_resolution": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "clarification_or_additional_theorem_required",
            "proposed_local_source_correction"
          ]
        },
        "text": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "status",
        "text"
      ],
      "type": "object"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "construction_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "type": "string"
        },
        "implementation_disposition": {
          "$ref": "#/$defs/implementation_disposition"
        },
        "issue_class": {
          "enum": [
            "open_source_obligation",
            "source_erratum_candidate"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "observed": {
          "minLength": 1,
          "type": "string"
        },
        "proposed_resolution": {
          "$ref": "#/$defs/proposed_resolution"
        },
        "reviewer_adjudication": {
          "$ref": "#/$defs/reviewer_adjudication"
        },
        "source_id": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "type": "string"
        },
        "test_bindings": {
          "items": {
            "$ref": "#/$defs/test_binding"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "upstream_confirmation": {
          "$ref": "#/$defs/upstream_confirmation"
        }
      },
      "required": [
        "construction_id",
        "id",
        "implementation_disposition",
        "issue_class",
        "locator",
        "observed",
        "proposed_resolution",
        "reviewer_adjudication",
        "source_id",
        "test_bindings",
        "upstream_confirmation"
      ],
      "type": "object"
    },
    "retrieval": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "type": "integer"
        },
        "retrieved_at_utc": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "url": {
          "pattern": "^https://export\\.arxiv\\.org/pdf/[0-9]{4}\\.[0-9]{5}v[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "byte_length",
        "retrieved_at_utc",
        "sha256",
        "url"
      ],
      "type": "object"
    },
    "reviewer_adjudication": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "primary_pdf_bytes_and_appendix_cross_check",
            "primary_pdf_bytes_and_dimensional_unit_check",
            "primary_pdf_bytes_and_local_algorithm_trace",
            "primary_pdf_bytes_and_open_mathematical_obligation",
            "primary_pdf_bytes_symmetry_and_dimensional_bookkeeping"
          ]
        },
        "status": {
          "enum": [
            "reviewer_derived_candidate_correction",
            "reviewer_derived_open_source_obligation"
          ]
        }
      },
      "required": [
        "basis",
        "status"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "arxiv_revision": {
          "pattern": "^arXiv:[0-9]{4}\\.[0-9]{5}v[0-9]+$",
          "type": "string"
        },
        "construction_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "publication_locator": {
          "minLength": 1,
          "type": "string"
        },
        "retrieval": {
          "$ref": "#/$defs/retrieval"
        },
        "retrieval_boundary": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "arxiv_revision",
        "construction_id",
        "publication_locator",
        "retrieval",
        "retrieval_boundary",
        "source_id",
        "title"
      ],
      "type": "object"
    },
    "test_binding": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "behavioral_regression",
            "negative_capability_guard",
            "source_only_guard"
          ]
        },
        "marker": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "pattern": "^(?:crates|scripts)/[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "test_name": {
          "pattern": "^[A-Za-z0-9_]+$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "marker",
        "path",
        "test_name"
      ],
      "type": "object"
    },
    "upstream_confirmation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "not_author_or_publisher_confirmed"
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "status",
        "summary"
      ],
      "type": "object"
    }
  },
  "$id": "https://pid.rs/schemas/source-errata.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "construction_firewall": {
      "additionalProperties": false,
      "properties": {
        "cross_construction_transfer": {
          "minLength": 1,
          "type": "string"
        },
        "mgw_uniform_binary_xor": {
          "additionalProperties": false,
          "properties": {
            "construction_id": {
              "const": "mgw-categorical-shared-exclusions"
            },
            "expected_redundancy_nats": {
              "const": "ln(2/3)"
            },
            "expected_synergy_nats": {
              "const": "ln(4/3)"
            },
            "scope": {
              "minLength": 1,
              "type": "string"
            },
            "test_binding": {
              "$ref": "#/$defs/test_binding"
            }
          },
          "required": [
            "construction_id",
            "expected_redundancy_nats",
            "expected_synergy_nats",
            "scope",
            "test_binding"
          ],
          "type": "object"
        }
      },
      "required": [
        "cross_construction_transfer",
        "mgw_uniform_binary_xor"
      ],
      "type": "object"
    },
    "constructions": {
      "items": {
        "$ref": "#/$defs/construction"
      },
      "minItems": 3,
      "type": "array",
      "uniqueItems": true
    },
    "nonimplications": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 4,
      "type": "array",
      "uniqueItems": true
    },
    "records": {
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "pid-rs/source-errata"
    },
    "schema_revision": {
      "const": 1
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "construction_firewall",
    "constructions",
    "nonimplications",
    "records",
    "schema",
    "schema_revision",
    "sources"
  ],
  "title": "pid-rs source errata and open source obligations",
  "type": "object"
}
