  "review_classes": {
    "advisory_review_record": {
      "obligations": [
        "Treat model output only as attack input, preserve failures and credit exhaustion, and exclude it from claim authority."
      ],
      "rationale": "Retain reproducible external-review prompts, responses, receipts, and independent adjudication without promoting model agreement to evidence."
    },
    "claim_evidence": {
      "obligations": [
        "Remain claim-scoped and avoid importing later PID-wave conclusions."
      ],
      "rationale": "Preserve revision-scoped KSG claim, certificate, route, or negative-result evidence."
    },
    "durable_process_state": {
      "obligations": [
        "Supersede stale live checkpoints with exact current anchors, bounded status, negative results, and next executable actions."
      ],
      "rationale": "Keep compaction recovery authoritative without turning mutable process state into scientific evidence."
    },
    "phase_authority": {
      "obligations": [
        "Reject deletions and non-policy paths before scientific gates run."
      ],
      "rationale": "Declare the separately reviewed anchor-relative KSG phase delta."
    },
    "public_documentation": {
      "obligations": [
        "State bounded claims, unresolved seams, and non-implications without overclaiming."
      ],
      "rationale": "Update human-facing KSG revision-4 integration documentation and limitations."
    },
    "release_metadata": {
      "obligations": [
        "Do not combine KSG closure with unverified PID2, PID3, or frontier claims."
      ],
      "rationale": "Keep machine and human KSG release metadata synchronized at revision-4 scope."
    },
    "rust_implementation": {
      "obligations": [
        "Preserve support-domain checks, estimator semantics, and deterministic binary64 behavior."
      ],
      "rationale": "Integrate the bounded KSG integer-harmonic implementation into its reviewed Rust route."
    },
    "rust_witness": {
      "obligations": [
        "Keep fixtures and assertions scoped to KSG revision 4 and reject later-wave oracle drift."
      ],
      "rationale": "Exercise the bounded KSG implementation and its deterministic cross-route witnesses."
    },
    "verification_tool": {
      "obligations": [
        "Run in normal and optimized Python modes with reviewed counts and negative controls."
      ],
      "rationale": "Provide a fail-closed KSG revision-4 generator, checker, or hostile self-test."
    },
    "verification_wiring": {
      "obligations": [
        "Keep route commands explicit, fail-closed, and separately count-guarded."
      ],
      "rationale": "Wire or document KSG revision-4 verification without changing later scientific scope."
    }
  },
  "schema": "pid-rs/ksg-phase-path-policy",
  "schema_revision": 1
}
