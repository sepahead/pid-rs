% Source Sans Pro carries navigation, metadata, headings, and labels; Latin Modern Roman carries
% the narrative and large report title. This is the reviewed repository-local report adaptation.
\setsansfont[
  ItalicFont=SourceSansPro-RegularIt.otf,
  BoldFont=SourceSansPro-Semibold.otf,
  BoldItalicFont=SourceSansPro-SemiboldIt.otf
]{SourceSansPro-Regular.otf}
\AtBeginDocument{\hypersetup{
  pdfauthor={pid-rs contributors},
  pdfsubject={Proposed PID discovery, verification, and durable-promotion architecture},
  pdfkeywords={partial information decomposition, SxPID3, formal verification, durable research workflow}
}}

% This report deliberately adopts the repository's quiet, patterned publication system.  The
% paper-grain is decorative only; headings, captions, labels, and prose carry the meaning.
\pgfdeclarepatternformonly{pidblueprintpapergrain}
  {\pgfpoint{0pt}{0pt}}
  {\pgfpoint{18pt}{18pt}}
  {\pgfpoint{18pt}{18pt}}
  {%
    \pgfsetlinewidth{0.12pt}%
    \pgfpathmoveto{\pgfpoint{1.5pt}{4.0pt}}%
    \pgfpathlineto{\pgfpoint{6.5pt}{4.3pt}}%
    \pgfpathmoveto{\pgfpoint{11.0pt}{12.0pt}}%
    \pgfpathlineto{\pgfpoint{16.0pt}{11.7pt}}%
    \pgfpathmoveto{\pgfpoint{4.0pt}{16.0pt}}%
    \pgfpathlineto{\pgfpoint{8.0pt}{15.8pt}}%
    \pgfusepath{stroke}%
  }
% A restrained eight-point girih-rosette field adapts the reviewed title-banner grammar.  It is
% decorative only: real text remains the sole carrier of title and status information.
\pgfdeclarepatternformonly{pidblueprinttitlerosette}
  {\pgfpoint{0pt}{0pt}}
  {\pgfpoint{20pt}{20pt}}
  {\pgfpoint{20pt}{20pt}}
  {%
    \pgfsetlinewidth{0.34pt}%
    \pgfsetroundcap%
    \pgfsetroundjoin%
    \pgfpathmoveto{\pgfpoint{10pt}{1pt}}%
    \pgfpathlineto{\pgfpoint{12.5pt}{7.5pt}}%
    \pgfpathlineto{\pgfpoint{19pt}{10pt}}%
    \pgfpathlineto{\pgfpoint{12.5pt}{12.5pt}}%
    \pgfpathlineto{\pgfpoint{10pt}{19pt}}%
    \pgfpathlineto{\pgfpoint{7.5pt}{12.5pt}}%
    \pgfpathlineto{\pgfpoint{1pt}{10pt}}%
    \pgfpathlineto{\pgfpoint{7.5pt}{7.5pt}}%
    \pgfpathclose%
    \pgfpathmoveto{\pgfpoint{10pt}{5.8pt}}%
    \pgfpathlineto{\pgfpoint{14.2pt}{10pt}}%
    \pgfpathlineto{\pgfpoint{10pt}{14.2pt}}%
    \pgfpathlineto{\pgfpoint{5.8pt}{10pt}}%
    \pgfpathclose%
    \pgfpathcircle{\pgfpoint{10pt}{10pt}}{0.65pt}%
    \pgfusepath{stroke}%
  }
\newcommand{\PidBlueprintPageGround}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[PidPale] (current page.south west) rectangle (current page.north east);
    \path[pattern=pidblueprintpapergrain,pattern color=PidMineral,opacity=0.24]
      (current page.south west) rectangle (current page.north east);
    \fill[PidNavy,opacity=0.08]
      (current page.north west) rectangle ([yshift=-2.1mm]current page.north east);
    \fill[PidBlue,opacity=0.07]
      ([yshift=2.1mm]current page.south west) rectangle (current page.south east);
  \end{tikzpicture}%
}
\AddToShipoutPictureBG{\PidBlueprintPageGround}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\sffamily\footnotesize\color{PidNavy}PID discovery, verification, and durability}
\fancyhead[R]{\sffamily\footnotesize\color{PidBlue}PrimeGaps lessons without semantic transfer}
\fancyfoot[L]{\sffamily\footnotesize\color{PidInk}pid-rs research blueprint · 3 September 2026}
\fancyfoot[R]{\sffamily\footnotesize\color{PidNavy}\thepage}
\setlength{\headheight}{15pt}

\titleformat{\section}
  {\sffamily\Large\bfseries\color{PidNavy}}
  {\thesection}{0.7em}{}
\titleformat{\subsection}
  {\sffamily\large\bfseries\color{PidBlue}}
  {\thesubsection}{0.7em}{}
\titleformat{\subsubsection}
  {\sffamily\normalsize\bfseries\color{PidGreen}}
  {\thesubsubsection}{0.7em}{}
\titlespacing*{\section}{0pt}{2.2ex plus .5ex}{1.0ex}
\titlespacing*{\subsection}{0pt}{1.8ex plus .4ex}{.8ex}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em plus 0.1em minus 0.08em}
\raggedbottom
% Reassert the page-break policy after every package has initialized.  Setting these values only
% while this header is read is insufficient if a later Pandoc template hook resets them.
\AtBeginDocument{%
  \widowpenalty=10000
  \clubpenalty=10000
  \displaywidowpenalty=10000
}
\setlist{leftmargin=1.65em,itemsep=.25em,topsep=.35em}
\setlength{\emergencystretch}{3em}
\setlength{\LTpre}{.5em}
\setlength{\LTpost}{.7em}
\renewcommand{\arraystretch}{1.16}
% Long source digests and Lean declaration names are exact evidence.  Let them wrap at character
% boundaries inside narrow table cells instead of clipping into neighbouring columns.
\AtBeginEnvironment{longtable}{%
  \footnotesize\RaggedRight
  \let\pidoldtexttt\texttt
  \renewcommand{\texttt}[1]{\pidoldtexttt{\seqsplit{#1}}}%
}
% Keep an assurance-table heading and first row together rather than leaving the header alone at
% a page foot.  The reservation applies uniformly because the renderer does not expose a safe
% block-level insertion point for one Markdown table.
\BeforeBeginEnvironment{longtable}{\Needspace{11\baselineskip}}
\captionsetup{font=small,labelfont={bf,color=PidBlue},textfont={color=PidInk},justification=raggedright,singlelinecheck=false,skip=7pt}

% The second argument remains descriptive source text.  This untagged LuaLaTeX projection does
% not claim that graphicx maps it to a PDF /Alt entry or that the output conforms to PDF/UA.
\newcommand{\PidBlueprintFigure}[3]{%
  \begin{figure}[H]
    \centering
    \includegraphics[width=\linewidth,alt={#2}]{#1}%
    \caption{#3}%
  \end{figure}%
}

\DefineVerbatimEnvironment{Highlighting}{Verbatim}{
  breaklines,
  breakanywhere,
  commandchars=\\\{\},
  fontsize=\small,
  frame=single,
  framesep=4pt,
  rulecolor=\color{PidBlue}
}

\makeatletter
\renewcommand{\maketitle}{%
  \begin{titlepage}
    \pagecolor{PidPale}\color{PidInk}
    \begin{tikzpicture}[remember picture,overlay]
      \shade[top color=PidNavy,bottom color=PidNavy!88!PidBlue]
        (current page.north west) rectangle ([yshift=-158mm]current page.north east);
      % Five equal pattern fields create a restrained opacity fade in and out.  The repeated
      % geometry never carries a status, quantity, or mathematical distinction.
      \path[pattern=pidblueprinttitlerosette,pattern color=white,opacity=0.045]
        (current page.north west) rectangle ([xshift=42mm,yshift=-158mm]current page.north west);
      \path[pattern=pidblueprinttitlerosette,pattern color=white,opacity=0.080]
        ([xshift=42mm]current page.north west) rectangle ([xshift=84mm,yshift=-158mm]current page.north west);
      \path[pattern=pidblueprinttitlerosette,pattern color=white,opacity=0.135]
        ([xshift=84mm]current page.north west) rectangle ([xshift=126mm,yshift=-158mm]current page.north west);
      \path[pattern=pidblueprinttitlerosette,pattern color=white,opacity=0.080]
        ([xshift=126mm]current page.north west) rectangle ([xshift=168mm,yshift=-158mm]current page.north west);
      \path[pattern=pidblueprinttitlerosette,pattern color=white,opacity=0.045]
        ([xshift=168mm]current page.north west) rectangle ([yshift=-158mm]current page.north east);
      \draw[PidSaffron,opacity=0.72,line width=0.8pt]
        ([xshift=18mm,yshift=-151mm]current page.north west) --
        ([xshift=-18mm,yshift=-151mm]current page.north east);
    \end{tikzpicture}%
    \vspace*{0.8cm}
    {\sffamily\Large\bfseries\color{PidSaffron}PID-RS RESEARCH PROGRAM\par}
    \vspace{1.8cm}
    {\fontsize{34}{40}\selectfont\bfseries\color{white}\@title\par}
    \vspace{5.2cm}
    \vfill
    \begin{minipage}{0.86\textwidth}
      \large\color{PidInk}
      A source-pinned historical 20-lens review, a 1 September 2026 70-lens publication-scope
      review, and a separate 10-route comparison of a proposed exact categorical SxPID3 assurance
      architecture, plus a 3 September owner-controlled Program-A semantic-evidence delta. The
      complete target and all five Programs remain open.
    \end{minipage}\par
    \vspace{1.4cm}
    {\sffamily\large\bfseries\color{PidBlue}\@date\par}
    \vspace{.6cm}
    {\sffamily\small\color{PidInk}Canonical narrative: \texttt{PID\_DISCOVERY\_VERIFICATION\_AND\_DURABILITY\_BLUEPRINT.md}\par}
  \end{titlepage}
  \nopagecolor\color{black}
}
