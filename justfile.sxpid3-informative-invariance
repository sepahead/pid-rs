set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

default: verify

bootstrap:
    cd audit/formal/lean && lake exe cache get

checker:
    python3 -I -S -B scripts/check-lean-sxpid3-informative-invariance.py
    python3 -O -I -S -B scripts/check-lean-sxpid3-informative-invariance.py

self-test:
    python3 -I -S -B scripts/check-lean-sxpid3-informative-invariance-self-test.py
    python3 -O -I -S -B scripts/check-lean-sxpid3-informative-invariance-self-test.py

parity:
    python3 -I -S -B scripts/check-lean-sxpid3-informative-invariance-parity.py

exact:
    python3 -I -S -B scripts/check-sxpid3-informative-invariance.py
    python3 -O -I -S -B scripts/check-sxpid3-informative-invariance.py
    python3 -I -S -B scripts/check-sxpid3-informative-invariance-self-test.py
    python3 -O -I -S -B scripts/check-sxpid3-informative-invariance-self-test.py

rust:
    RUSTFLAGS="-D warnings" cargo test --locked -p pid-core --no-default-features --test sxpid_informative_invariance

verify: bootstrap parity exact rust
