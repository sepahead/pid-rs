# Rust / Cargo ---------------------------------------------------------------
# The root workspace and cargo-fuzz workspace use independent target dirs.
/target/
/fuzz/target/
/fuzz/artifacts/
/audit/tools/certified-sxpid/target/
/audit/formal/lean/.lake/
**/*.rs.bk
/rust-project.json

# Coverage / profiling -------------------------------------------------------
# CI uploads these reports; local copies and raw compiler counters are derived.
/lcov.info
/coverage.xml
/coverage/
/htmlcov/
/.coverage
/.coverage.*
*.profraw
*.profdata
*.gcda
*.gcno

# Python / PyO3 / maturin ----------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/

# Keep virtual environments local whether created at the root or Python crate.
/.venv/
/venv/
/env/
/crates/pid-python/.venv/
/crates/pid-python/venv/
/crates/pid-python/env/

# Python packaging output. Cargo's own packages remain under ignored target/.
/build/
/dist/
/wheelhouse/
/crates/pid-python/build/
/crates/pid-python/dist/
/crates/pid-python/wheelhouse/
.eggs/
*.egg-info/
pip-wheel-metadata/

# In-place extension builds only; do not hide arbitrary native-library fixtures.
/pid_core_rs*.so
/pid_core_rs*.dylib
/pid_core_rs*.dll
/pid_core_rs*.pyd
/pid_core_rs*.pdb
/crates/pid-python/pid_core_rs*.so
/crates/pid-python/pid_core_rs*.dylib
/crates/pid-python/pid_core_rs*.dll
/crates/pid-python/pid_core_rs*.pyd
/crates/pid-python/pid_core_rs*.pdb

# Release / package / SBOM staging ------------------------------------------
# Workflows upload these outputs. Release scope and audit evidence stay tracked.
/release/
/pypi-dist/
/downloaded/
/downloaded-after-publication/
/pid-rs-*-review/
/pid-rs-*-x86_64-*/
/pid-rs-*-aarch64-*/
/pid-rs-*-source.tar.gz
/REVIEW_RELEASE_PROVENANCE.txt
/BUILD_PROVENANCE.txt
/FINALIZATION_PROVENANCE.txt
/SHA256SUMS
/SHA512SUMS
/PRE_APPROVAL_SHA256SUMS
/PRE_APPROVAL_SHA512SUMS
/*.cdx.json
/crates/*/*.cdx.json
/*.sarif

# Local credentials / environment ------------------------------------------
